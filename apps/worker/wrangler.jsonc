{
  "name": "zpjj-base",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../web/out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/healthz"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "zpjj-base", "database_id": "933bc941-2855-44f5-ba9f-fd3ab2b63649", "migrations_dir": "migrations" }
  ],
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": { "ENV": "prod" }
}
